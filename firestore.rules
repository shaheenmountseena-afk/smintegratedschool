rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // SHAHEEN – MOUNT SEENA FIRESTORE SECURITY RULES
    // Server-Authoritative Architecture:
    // All database reads, writes, and admin operations are executed through
    // the trusted Next.js Server-Side Firebase Admin SDK.
    // Direct client-side access is strictly denied across all collections.
    // ========================================================================

    // 1. Admins Collection: Strictly inaccessible from Client SDK.
    // Only Firebase Admin SDK on the server can read or modify administrator records.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // 2. Enquiries Collection: Client SDK direct read/write strictly denied.
    // Enquiries are validated and inserted through the Next.js API route (/api/enquiry)
    // using Firebase Admin SDK. Prevents scraping of student leads and spam floods.
    match /enquiries/{enquiryId} {
      allow read, write: if false;
    }

    // 3. Faculty Collection: Direct client reads & writes strictly denied.
    match /faculty/{facultyId} {
      allow read, write: if false;
    }

    // 4. Home Media Collection: Direct client reads & writes strictly denied.
    match /homeMedia/{mediaId} {
      allow read, write: if false;
    }

    // 5. Results Collection: Direct client reads & writes strictly denied.
    match /results/{resultId} {
      allow read, write: if false;
    }

    // 6. Gallery Collection: Direct client reads & writes strictly denied.
    match /gallery/{itemId} {
      allow read, write: if false;
    }

    // 7. Metadata Collection: Direct client reads & writes strictly denied.
    match /metadata/{metaId} {
      allow read, write: if false;
    }

    // Default Catch-All: Deny all direct client access across all paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
